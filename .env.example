# LawRide environment variables.
#
# Copy to .env.local for local dev, and set the same values in
# Vercel → Settings → Environment Variables for production.
#
# Every one of these fails SILENTLY when missing — by design, so a
# misconfigured deploy degrades instead of erroring in a user's face. That makes
# them easy to forget, which is why they're all listed here with the specific
# consequence of leaving each one out.

# ---------------------------------------------------------------------------
# REQUIRED for the AI features (/api/strategy, /api/recommendations, /api/resume)
# ---------------------------------------------------------------------------
# Missing → those three endpoints return 500 "API key not configured". The
# estimator itself still works; resume upload falls back to the manual dropdown.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# REQUIRED for the outcome dataset (/api/submit, /api/event)
# ---------------------------------------------------------------------------
# Missing → /api/submit returns { saved: false, reason: "not_configured" } and
# /api/event drops every event. The user sees a soft "couldn't save" and the
# estimate still works, so NOTHING VISIBLY BREAKS — you just silently collect no
# data at all. If your `submissions` table is unexpectedly empty, check these
# first.
#
# Both come from Supabase → Project Settings → API. Use the SERVICE ROLE key,
# not the anon key: `submissions` and `events` have RLS on with no policies, so
# the anon key can't write to them. The service_role key bypasses RLS and must
# NEVER be exposed to the client — it is only ever read in api/_db.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED — the real guard on Anthropic spend
# ---------------------------------------------------------------------------
# Missing → per-IP rate limiting degrades to a per-instance in-memory window
# that resets on every cold start and isn't shared across serverless instances,
# and the global daily cap below becomes a NO-OP. In other words: without these,
# nothing meaningfully caps what a determined caller can spend on your API key.
#
# Add via the Vercel Marketplace Upstash Redis integration, which sets both.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Global ceiling on paid AI calls per day across ALL callers. Only enforceable
# when Upstash is configured. Defaults to 3000 — generous enough that real users
# are never the ones capped.
AI_DAILY_CALL_CAP=3000
